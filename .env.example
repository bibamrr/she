SHC_SECRET_KEY=change-me-in-production
SHC_DATABASE_URL=sqlite:///./data/shc.db
SHC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
SHC_PUBLIC_BASE_URL=http://127.0.0.1:8000
BINANCE_TESTNET=false
# Public Binance market-data mirror (not api.binance.com — that returns 451 from Render/US clouds)
SHC_BINANCE_REST_HOST=https://data-api.binance.vision
# Optional proxy if you still need fapi.binance.com (futures) from a blocked region
SHC_MARKET_HTTP_PROXY=

# Tadawul / US candles
# Preferred: Twelve Data (https://twelvedata.com). Empty → TradingView history, then Yahoo.
SHC_TWELVEDATA_KEY=

# Email: console | resend | sendgrid | smtp
SHC_EMAIL_PROVIDER=console
SHC_EMAIL_API_KEY=
SHC_EMAIL_FROM=SHC <no-reply@shc.local>
SHC_SMTP_HOST=
SHC_SMTP_PORT=587
SHC_SMTP_USER=
SHC_SMTP_PASSWORD=

# In-app assistant: local | anthropic | openai
SHC_ASSISTANT_PROVIDER=local
SHC_ASSISTANT_API_KEY=
SHC_ASSISTANT_MODEL=claude-sonnet-4-5

# Comma-separated emails that become platform admins on register
SHC_ADMIN_EMAILS=

# Payments — leave Stripe empty to use the local test checkout desk
SHC_STRIPE_SECRET_KEY=
SHC_STRIPE_WEBHOOK_SECRET=
SHC_STRIPE_PUBLISHABLE_KEY=
# stripe listen --forward-to localhost:8000/api/subscriptions/stripe/webhook

# Telegram Bot API token from @BotFather (required for outbound Telegram alerts)
SHC_TELEGRAM_BOT_TOKEN=
SHC_ALERT_SCAN_SECONDS=60
SHC_ALERT_MIN_CONFIDENCE=90
